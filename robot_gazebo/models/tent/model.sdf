<?xml version="1.0"?>
<!-- Medical tent 4 x 3 m with a red cross on the roof -->
<sdf version="1.9">
  <model name="tent">
    <static>true</static>
    <link name="link">
      <visual name="body">
        <pose>0 0 1.0 0 0 0</pose>
        <geometry><box><size>4 3 2</size></box></geometry>
        <material>
          <ambient>0.9 0.9 0.88 1</ambient>
          <diffuse>0.9 0.9 0.88 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><metalness>0.0</metalness><roughness>0.95</roughness></metal></pbr>
        </material>
      </visual>
      <collision name="body_collision">
        <pose>0 0 1.0 0 0 0</pose>
        <geometry><box><size>4 3 2</size></box></geometry>
      </collision>
      <visual name="roof_n">
        <pose>0 0.75 2.4 -0.4900 0 0</pose>
        <geometry><box><size>4.2 1.850 0.05</size></box></geometry>
        <material>
          <ambient>0.9 0.9 0.88 1</ambient>
          <diffuse>0.9 0.9 0.88 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><metalness>0.0</metalness><roughness>0.95</roughness></metal></pbr>
        </material>
      </visual>
      <visual name="roof_s">
        <pose>0 -0.75 2.4 0.4900 0 0</pose>
        <geometry><box><size>4.2 1.850 0.05</size></box></geometry>
        <material>
          <ambient>0.9 0.9 0.88 1</ambient>
          <diffuse>0.9 0.9 0.88 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><metalness>0.0</metalness><roughness>0.95</roughness></metal></pbr>
        </material>
      </visual>
      <visual name="cross_v">
        <pose>0 0.75 2.43 -0.49 0 0</pose>
        <geometry><box><size>0.3 1.0 0.01</size></box></geometry>
        <material>
          <ambient>0.85 0.05 0.05 1</ambient>
          <diffuse>0.85 0.05 0.05 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><metalness>0.0</metalness><roughness>0.8</roughness></metal></pbr>
        </material>
      </visual>
      <visual name="cross_h">
        <pose>0 0.75 2.43 -0.49 0 0</pose>
        <geometry><box><size>1.0 0.3 0.01</size></box></geometry>
        <material>
          <ambient>0.85 0.05 0.05 1</ambient>
          <diffuse>0.85 0.05 0.05 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><metalness>0.0</metalness><roughness>0.8</roughness></metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
