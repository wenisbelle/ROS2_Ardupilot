<?xml version="1.0"?>
<!-- 2 x 2 m landing pad (H oriented along +y = North). Top at z = 0.02 m -->
<sdf version="1.9">
  <model name="landing_pad">
    <static>true</static>
    <link name="link">
      <visual name="pad">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry><box><size>2 2 0.02</size></box></geometry>
        <material>
          <ambient>0.62 0.62 0.6 1</ambient>
          <diffuse>0.62 0.62 0.6 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><metalness>0.0</metalness><roughness>0.9</roughness></metal></pbr>
        </material>
      </visual>
      <collision name="pad_collision">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry><box><size>2 2 0.02</size></box></geometry>
      </collision>
      <visual name="ring">
        <pose>0 0 0.021 0 0 0</pose>
        <geometry><cylinder><radius>0.85</radius><length>0.002</length></cylinder></geometry>
        <material>
          <ambient>0.95 0.8 0.1 1</ambient>
          <diffuse>0.95 0.8 0.1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><metalness>0.0</metalness><roughness>0.6</roughness></metal></pbr>
        </material>
      </visual>
      <visual name="ring_inner">
        <pose>0 0 0.0225 0 0 0</pose>
        <geometry><cylinder><radius>0.75</radius><length>0.002</length></cylinder></geometry>
        <material>
          <ambient>0.62 0.62 0.6 1</ambient>
          <diffuse>0.62 0.62 0.6 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><metalness>0.0</metalness><roughness>0.9</roughness></metal></pbr>
        </material>
      </visual>
      <visual name="h_left">
        <pose>-0.25 0 0.024 0 0 0</pose>
        <geometry><box><size>0.12 0.8 0.002</size></box></geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><metalness>0.0</metalness><roughness>0.6</roughness></metal></pbr>
        </material>
      </visual>
      <visual name="h_right">
        <pose>0.25 0 0.024 0 0 0</pose>
        <geometry><box><size>0.12 0.8 0.002</size></box></geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><metalness>0.0</metalness><roughness>0.6</roughness></metal></pbr>
        </material>
      </visual>
      <visual name="h_bar">
        <pose>0 0 0.024 0 0 0</pose>
        <geometry><box><size>0.5 0.12 0.002</size></box></geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr><metal><metalness>0.0</metalness><roughness>0.6</roughness></metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
