<?xml version="1.0" ?>
<!-- ========================================================================== -->
<!--  farm.sdf - rural area: crop fields, barn, silos, farmhouse              -->
<!--  Agriculture / inspection scenarios: crop rows (row following,           -->
<!--  mapping), buildings and silos (inspection), people and vehicles         -->
<!--  (detection). GPS origin: countryside of Sao Paulo, Brazil.              -->
<!--                                                                            -->
<!--  Drone take-off pads: x = 0, 3, 6, 9, 12, 15 m (y = 0) -> default spawn    -->
<!--  All the scenery is static (dynamic cones / barrels cost ~35 % of the RTF)  -->
<!--  of drone1..drone6. World frame: ENU (+x East, +y North), the origin is    -->
<!--  the GPS origin (spherical_coordinates) used by ArduPilot SITL (home) and  -->
<!--  by the swarm "map" frame.                                                 -->
<!-- ========================================================================== -->
<sdf version="1.9">
  <world name="farm">

    <!-- 1 kHz physics: ArduPilot SITL runs lock-step with Gazebo (JSON backend) -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- IMU sensor of the drones (read by the ArduPilotPlugin) -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Wind / body drag on links with enable_wind (drone base_link).
         force_approximation_scaling_factor k calibrated in flight: the measured force
         is ~1.1 * k^2 * mass * (v_wind - v_link); k = 0.37 -> ~0.15 * m * v, i.e.
         X500 ~3 N and big hexa ~9 N at 10 m/s (lean ~7 deg to hold position).
         Active after the first wind message (world.launch.py sends it at start).
         Change at run time: ros2 run robot_gazebo set_wind -s 5 -d 90 -->
    <plugin filename="gz-sim-wind-effects-system" name="gz::sim::systems::WindEffects">
      <force_approximation_scaling_factor>0.37</force_approximation_scaling_factor>
      <horizontal>
        <magnitude>
          <time_for_rise>10</time_for_rise>
          <sin>
            <amplitude_percent>0.15</amplitude_percent>
            <period>12</period>
          </sin>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.3</stddev>
          </noise>
        </magnitude>
        <direction>
          <time_for_rise>30</time_for_rise>
          <sin>
            <amplitude>10</amplitude>
            <period>20</period>
          </sin>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>3</stddev>
          </noise>
        </direction>
      </horizontal>
      <vertical>
        <noise type="gaussian">
          <mean>0</mean>
          <stddev>0.1</stddev>
        </noise>
      </vertical>
    </plugin>
    <wind>
      <linear_velocity>0 0 0</linear_velocity>
    </wind>

    <!-- GPS origin of the world (= ArduPilot SITL home of every drone) -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>-22.7253</latitude_deg>
      <longitude_deg>-47.6492</longitude_deg>
      <elevation>540</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.62 0.76 0.92 1</background>
      <shadows>true</shadows>
      <sky></sky>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.85</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>2000 2000</size></plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground">
          <geometry>
            <plane><normal>0 0 1</normal><size>2000 2000</size></plane>
          </geometry>
          <material>
            <ambient>0.36 0.48 0.2 1</ambient>
            <diffuse>0.36 0.48 0.2 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================= -->
    <!-- Take-off area: 6 landing pads (drone1..drone6 default spawn)    -->
    <!-- ================================================================= -->
    <model name="farm_yard">
      <static>true</static>
      <pose>7.5 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>30 12 0.01</size></box></geometry>
          <material>
            <ambient>0.45 0.36 0.25 1</ambient>
            <diffuse>0.45 0.36 0.25 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <include>
      <uri>model://landing_pad</uri>
      <name>pad_1</name>
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
    </include>
    <include>
      <uri>model://landing_pad</uri>
      <name>pad_2</name>
      <static>true</static>
      <pose>3 0 0.01 0 0 0</pose>
    </include>
    <include>
      <uri>model://landing_pad</uri>
      <name>pad_3</name>
      <static>true</static>
      <pose>6 0 0.01 0 0 0</pose>
    </include>
    <include>
      <uri>model://landing_pad</uri>
      <name>pad_4</name>
      <static>true</static>
      <pose>9 0 0.01 0 0 0</pose>
    </include>
    <include>
      <uri>model://landing_pad</uri>
      <name>pad_5</name>
      <static>true</static>
      <pose>12 0 0.01 0 0 0</pose>
    </include>
    <include>
      <uri>model://landing_pad</uri>
      <name>pad_6</name>
      <static>true</static>
      <pose>15 0 0.01 0 0 0</pose>
    </include>

    <!-- ================================================================= -->
    <!-- Farm buildings                                                  -->
    <!-- ================================================================= -->
    <include>
      <uri>model://house_two_storey</uri>
      <name>farmhouse</name>
      <static>true</static>
      <pose>-40 35 0 0 0 -1.5708</pose>
    </include>
    <include>
      <uri>model://barn</uri>
      <name>barn</name>
      <static>true</static>
      <pose>35 40 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://silo</uri>
      <name>silo_1</name>
      <static>true</static>
      <pose>55 33 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://silo</uri>
      <name>silo_2</name>
      <static>true</static>
      <pose>55 45 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Water Tower</uri>
      <name>water_tower</name>
      <static>true</static>
      <pose>-25 -35 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pickup</uri>
      <name>pickup</name>
      <static>true</static>
      <pose>22 22 0 0 0 1.2</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Casual female</uri>
      <name>farmer_1</name>
      <static>true</static>
      <pose>25 14 0 0 0 0</pose>
    </include>

    <!-- ================================================================= -->
    <!-- Dirt road and crop fields (40 x 30 m each, rows along x)        -->
    <!-- ================================================================= -->
    <model name="dirt_road">
      <static>true</static>
      <pose>75 -18 0.006 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>160 5 0.01</size></box></geometry>
          <material>
            <ambient>0.5 0.4 0.28 1</ambient>
            <diffuse>0.5 0.4 0.28 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <include>
      <uri>model://crop_field</uri>
      <name>field_1</name>
      <static>true</static>
      <pose>100 5 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://crop_field</uri>
      <name>field_2</name>
      <static>true</static>
      <pose>100 45 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://crop_field</uri>
      <name>field_3</name>
      <static>true</static>
      <pose>150 5 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://crop_field</uri>
      <name>field_4</name>
      <static>true</static>
      <pose>150 45 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing person</uri>
      <name>worker_1</name>
      <static>true</static>
      <pose>120 -12 0 0 0 0</pose>
    </include>

    <!-- ================================================================= -->
    <!-- Fences (pasture) and hay bales                                  -->
    <!-- ================================================================= -->
    <include>
      <uri>model://fence</uri>
      <name>fence_s_1</name>
      <static>true</static>
      <pose>-15 -30 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://fence</uri>
      <name>fence_s_2</name>
      <static>true</static>
      <pose>5 -30 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://fence</uri>
      <name>fence_s_3</name>
      <static>true</static>
      <pose>25 -30 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://fence</uri>
      <name>fence_s_4</name>
      <static>true</static>
      <pose>45 -30 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://fence</uri>
      <name>fence_w_1</name>
      <static>true</static>
      <pose>-25 -20 0 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://fence</uri>
      <name>fence_w_2</name>
      <static>true</static>
      <pose>-25 0 0 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://hay_bale</uri>
      <name>hay_1</name>
      <static>true</static>
      <pose>30 -55 0 0 0 0.2</pose>
    </include>
    <include>
      <uri>model://hay_bale</uri>
      <name>hay_2</name>
      <static>true</static>
      <pose>34 -57 0 0 0 1.1</pose>
    </include>
    <include>
      <uri>model://hay_bale</uri>
      <name>hay_3</name>
      <static>true</static>
      <pose>27 -60 0 0 0 0.6</pose>
    </include>
    <include>
      <uri>model://hay_bale</uri>
      <name>hay_4</name>
      <static>true</static>
      <pose>40 -62 0 0 0 2</pose>
    </include>
    <include>
      <uri>model://hay_bale</uri>
      <name>hay_5</name>
      <static>true</static>
      <pose>36 -66 0 0 0 0.4</pose>
    </include>

    <!-- ================================================================= -->
    <!-- Trees: windbreak (west) and around the house                    -->
    <!-- ================================================================= -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <name>windbreak_1</name>
      <static>true</static>
      <pose>-70 -75 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <name>windbreak_2</name>
      <static>true</static>
      <pose>-70 -60 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <name>windbreak_3</name>
      <static>true</static>
      <pose>-70 -45 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <name>windbreak_4</name>
      <static>true</static>
      <pose>-70 -30 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <name>windbreak_5</name>
      <static>true</static>
      <pose>-70 -15 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <name>windbreak_6</name>
      <static>true</static>
      <pose>-70 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <name>windbreak_7</name>
      <static>true</static>
      <pose>-70 15 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <name>windbreak_8</name>
      <static>true</static>
      <pose>-70 30 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <name>windbreak_9</name>
      <static>true</static>
      <pose>-70 45 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <name>windbreak_10</name>
      <static>true</static>
      <pose>-70 60 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <name>windbreak_11</name>
      <static>true</static>
      <pose>-70 75 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <name>oak_1</name>
      <static>true</static>
      <pose>-55 55 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <name>oak_2</name>
      <static>true</static>
      <pose>-25 58 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <name>oak_3</name>
      <static>true</static>
      <pose>-58 20 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <name>oak_4</name>
      <static>true</static>
      <pose>70 -45 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <name>oak_5</name>
      <static>true</static>
      <pose>5 40 0 0 0 0</pose>
    </include>

  </world>
</sdf>
