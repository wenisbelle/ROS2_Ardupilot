    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <name>barrier_1</name>
      <static>true</static>
      <pose>-8 -17 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <name>barrier_2</name>
      <static>true</static>
      <pose>-3 -17 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <name>barrier_3</name>
      <static>true</static>
      <pose>2 -17 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <name>barrier_4</name>
      <static>true</static>
      <pose>7 -17 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <name>barrier_5</name>
      <static>true</static>
      <pose>12 -17 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <name>barrier_6</name>
      <static>true</static>
      <pose>17 -17 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <name>barrier_7</name>
      <static>true</static>
      <pose>22 -17 0 0 0 0</pose>
    </include>

    <!-- ================================================================= -->
    <!-- Disaster zone                                                   -->
    <!-- ================================================================= -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Collapsed House</uri>
      <name>collapsed_1</name>
      <static>true</static>
      <pose>60 25 0 0 0 0</pose>
    </include>
    <include>
