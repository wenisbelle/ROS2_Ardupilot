# =============================================================================
# Simulation profile "realistic": sensor imperfections close to a real drone
# (soft-mounted FC with ICM-42688 class IMUs, u-blox M9N class GPS).
# Combine with Gazebo wind / gusts:  ros2 run robot_gazebo set_wind --speed 5 --from 90
# (SITL SIM_WIND_* do NOT act on the Gazebo physics, only on SITL internal models)
# =============================================================================

# IMUs: white noise (accel m/s/s, gyro deg/s) and a small accel bias on IMU 1
SIM_ACC1_RND     0.3
SIM_ACC2_RND     0.3
SIM_GYR1_RND     0.3
SIM_GYR2_RND     0.3
SIM_ACC1_BIAS_X  0.05
SIM_ACC1_BIAS_Y  -0.04

# Barometers: noise (m)
SIM_BARO_RND     0.25
SIM_BAR2_RND     0.25

# Magnetometer noise
SIM_MAG_RND      3

# GPS: 10 Hz, 120 ms latency, ~0.5 m noise, 14 satellites
SIM_GPS1_HZ      10
SIM_GPS1_LAG_MS  120
SIM_GPS1_NOISE   0.5
SIM_GPS1_NUMSATS 14
SIM_GPS1_ACC     0.6
