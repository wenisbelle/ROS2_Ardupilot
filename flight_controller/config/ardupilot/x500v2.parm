# =============================================================================
# Holybro X500 V2 (robot_description/sdf/frame_x500v2.xacro)
#   quad X, 2.0 kg, 10" props, T/W ~2.1, hover ~0.5 (linearised thrust)
# Starting point for the real drone too, but ALWAYS tune the real airframe
# (AutoTune / QuikTune): the simulated rotor model is an approximation.
# =============================================================================
FRAME_CLASS      1
FRAME_TYPE       1

MOT_THST_HOVER   0.50
MOT_SPIN_ARM     0.10
MOT_SPIN_MIN     0.15

# Rate controller (tuned in this simulation)
ATC_RAT_RLL_P    0.20
ATC_RAT_RLL_I    0.20
ATC_RAT_RLL_D    0.006
ATC_RAT_PIT_P    0.20
ATC_RAT_PIT_I    0.20
ATC_RAT_PIT_D    0.006
ATC_RAT_YAW_P    0.60
ATC_RAT_YAW_I    0.06
# max yaw acceleration, deg/s/s (4.6: ATC_ACCEL_Y_MAX in cdeg/s/s)
ATC_ACC_Y_MAX    180
