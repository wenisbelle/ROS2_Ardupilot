# =============================================================================
# Parameters common to EVERY simulated drone.
# Written for ArduPilot Copter 4.7 (SI unit parameter names). Unknown names
# are silently ignored by SITL: when changing ARDUPILOT_VERSION check them with
#   ros2 param get /drone1/mavros/param <NAME>
# Load order (later files override earlier ones):
#   1. ArduPilot  Tools/autotest/default_params/copter.parm  (SITL calibration, RC, modes)
#   2. sitl_common.parm                                       (this file)
#   3. <frame>.parm                                           (x500v2.parm, hexa.parm)
#   4. profile_<profile>.parm                                 (ideal / realistic)
#   5. instance.parm (generated by sitl.launch.py: RTL_ALT staggered per drone)
#   6. extra_params:=...                                      (your files, e.g. exported from the real drone)
# MAV_SYSID (ex SYSID_THISMAV) is set by the launch (--sysid = drone id).
# =============================================================================

# --- Motor outputs: must match servo_min/servo_max of the Gazebo model -------
MOT_PWM_MIN      1100
MOT_PWM_MAX      1900
MOT_PWM_TYPE     0
# thrust ~ (rotor speed)^2 and rotor speed ~ command -> expo ~0.7
MOT_THST_EXPO    0.7
MOT_HOVER_LEARN  2

# --- MAVLink streams on SERIAL0 = TCP 5760+10*i (MAVROS / companion link) --
# ArduPilot >= 4.7 names them MAV1_* (SR0_* in 4.6 and older).
# drone_commander also requests these streams through MAVROS at start-up, so
# the rates are right on any firmware version / serial port (real drone).
MAV1_RAW_SENS    2
MAV1_EXT_STAT    2
MAV1_RC_CHAN     2
MAV1_RAW_CTRL    0
MAV1_POSITION    20
MAV1_EXTRA1      20
MAV1_EXTRA2      10
MAV1_EXTRA3      2
MAV1_PARAMS      10

# --- GUIDED mode (velocity / position commands from ROS 2) -----------------
# velocity / acceleration commands time out after GUID_TIMEOUT s -> the drone stops
GUID_TIMEOUT     3
# GUIDED navigation speeds / acceleration, used for position targets
# (ArduPilot >= 4.7 uses SI units; 4.6 names in brackets: WPNAV_SPEED cm/s...)
WP_SPD           5.0
WP_SPD_UP        2.5
WP_SPD_DN        1.5
WP_ACC           2.5
WP_RADIUS_M      1.0

# --- Return to launch / landing (4.6: RTL_ALT cm, RTL_SPEED, LAND_SPEED cm/s) ---
# RTL_ALT_M is overridden per drone by instance.parm (staggered altitudes)
RTL_ALT_M        15
RTL_SPEED_MS     0
LAND_SPD_MS      0.5
LAND_SPD_HIGH_MS 0

# --- Failsafes (adapt on the real drone) -----------------------------------
# RC throttle failsafe stays enabled (copter.parm). GCS failsafe disabled:
# in a swarm the drones are commanded by ROS 2, not by a single GCS.
FS_GCS_ENABLE    0
FS_EKF_ACTION    1
FS_CRASH_CHECK   1

# --- Estimation: the real EKF3 (as on the drone), never the SITL "perfect" AHRS (type 10)
AHRS_EKF_TYPE    3

# --- Misc ---------------------------------------------------------------------
FENCE_ENABLE     0
LOG_DISARMED     0
LOG_BACKEND_TYPE 1
