<?xml version="1.0"?>
<!-- =========================================================================
  ArduPilot multirotor for Gazebo Sim Harmonic (SDF generated by xacro).

  xacro drone.sdf.xacro frame:=x500v2 name:=drone1 instance:=0 > drone1.sdf

  args
    frame         x500v2 | hexa          (frame_<frame>.xacro)
    name          model name in Gazebo = ROS namespace of the drone (drone1, ...)
    instance      ArduPilot SITL instance (0, 1, 2 ...) -> JSON port 9002 + 10 * instance
    camera        true | false           RGB camera (vision / AI)
    camera_pitch  tilt down [rad], "default" = frame default (x500v2 20 deg, hexa 45 deg)

  Model frame: x forward, y left, z up (FLU). The ArduPilotPlugin converts
  to ArduPilot FRD / NED.
  ========================================================================= -->
<sdf version="1.9" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="frame" default="x500v2"/>
  <xacro:arg name="name" default="drone1"/>
  <xacro:arg name="instance" default="0"/>
  <xacro:arg name="camera" default="true"/>
  <xacro:arg name="camera_pitch" default="default"/>

  <xacro:property name="frame" value="$(arg frame)"/>
  <xacro:property name="name" value="$(arg name)"/>
  <xacro:property name="fdm_port_in" value="${9002 + 10 * int('$(arg instance)')}"/>

  <xacro:include filename="inertial_macros.xacro"/>
  <xacro:include filename="materials.xacro"/>
  <xacro:include filename="rotor.xacro"/>
  <xacro:include filename="IMU.xacro"/>
  <xacro:include filename="camera.xacro"/>
  <xacro:include filename="ardupilot_plugin.xacro"/>
  <xacro:include filename="gazebo_essentials.xacro"/>
  <xacro:include filename="frame_${frame}.xacro"/>

  <xacro:property name="cam_pitch"
                  value="${camera_pitch_default if '$(arg camera_pitch)' == 'default' else float('$(arg camera_pitch)')}"/>

  <model name="${name}">
    <xacro:drone_frame name="${name}" fdm_port_in="${fdm_port_in}"
                       camera="$(arg camera)" cam_pitch="${cam_pitch}"/>
  </model>

</sdf>
