<?xml version="1.0"?>
<!-- =========================================================================
  Gazebo-only helpers (not part of the real drone)
  - Ground truth odometry (pose in the world ENU frame = swarm "map" frame)
    to evaluate estimation / swarm algorithms against the true state.
    gz topic <name>/ground_truth/odometry -> ROS /<name>/ground_truth/odometry
  ========================================================================= -->
<sdf version="1.9" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="gazebo_essentials" params="name">
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>${name}/base_link</robot_base_frame>
      <odom_topic>${name}/ground_truth/odometry</odom_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </xacro:macro>

</sdf>
