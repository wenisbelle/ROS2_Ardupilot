<?xml version="1.0"?>
<!-- =========================================================================
  Rotor = propeller link + revolute joint + 2 LiftDrag "blades".

  Same aerodynamic model as the ArduPilot iris (ardupilot_gazebo): the
  ArduPilotPlugin closes a velocity loop on the joint (PID -> joint torque) and
  each blade generates lift / drag at its centre of pressure (cp) with
  gz::sim::systems::LiftDrag. Per rotor, at angular speed w:

      thrust T = rho * blade_area * CL * (w * blade_cp)^2      (2 blades)
      CL = cla * a0 = 4.25 * 0.3 = 1.275

  The reaction torque on the frame (yaw authority) comes from the joint
  damping (rotor_damping * w) plus the blade drag.

  Properties that must exist in the frame file (frame_<name>.xacro):
    rotor_mass rotor_ixx rotor_izz rotor_damping blade_cp blade_area
    prop_radius prop_scale bell_scale
  Turning direction: dir = 1 -> CCW seen from above (+z), dir = -1 -> CW
  ========================================================================= -->
<sdf version="1.9" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="air_density" value="1.2041"/>

  <!-- One blade of the LiftDrag model -->
  <xacro:macro name="rotor_blade" params="index side dir">
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>${blade_area}</area>
      <air_density>${air_density}</air_density>
      <cp>${side * blade_cp} 0 0</cp>
      <!-- direction of motion of this blade for the turning direction of the rotor -->
      <forward>0 ${side * dir} 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_${index}</link_name>
    </plugin>
  </xacro:macro>

  <xacro:macro name="rotor" params="index x y z dir">
    <link name="rotor_${index}">
      <pose>${x} ${y} ${z} 0 0 0</pose>
      <xacro:inertial_diag mass="${rotor_mass}" ixx="${rotor_ixx}" iyy="${rotor_izz}" izz="${rotor_izz}"/>
      <visual name="prop_visual">
        <pose>${-0.026 * prop_scale} ${-0.173 * prop_scale} ${-0.0189 * prop_scale} 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>${prop_scale} ${prop_scale} ${prop_scale}</scale>
            <xacro:if value="${dir > 0}">
              <uri>model://x500_base/meshes/1345_prop_ccw.stl</uri>
            </xacro:if>
            <xacro:unless value="${dir > 0}">
              <uri>model://x500_base/meshes/1345_prop_cw.stl</uri>
            </xacro:unless>
          </mesh>
        </geometry>
        <xacro:material_rgb r="0.08" g="0.08" b="0.08" metal="0.1" rough="0.4"/>
      </visual>
      <visual name="motor_bell_visual">
        <pose>0 0 ${-0.032 * bell_scale} 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>${bell_scale} ${bell_scale} ${bell_scale}</scale>
            <uri>model://x500_base/meshes/5010Bell.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="prop_collision">
        <geometry>
          <cylinder>
            <radius>${prop_radius}</radius>
            <length>0.004</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="rotor_${index}_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_${index}</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <damping>${rotor_damping}</damping>
        </dynamics>
      </axis>
    </joint>

    <xacro:rotor_blade index="${index}" side="1" dir="${dir}"/>
    <xacro:rotor_blade index="${index}" side="-1" dir="${dir}"/>

    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>rotor_${index}_joint</joint_name>
    </plugin>
  </xacro:macro>

</sdf>
